# ============================================================
# Trading Bot — Environment Configuration Template
# Copy this to .env and fill in your values
# ============================================================

# ── MT5 Credentials ──────────────────────────────────────────
MT5_LOGIN=YOUR_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_PASSWORD
MT5_SERVER=YOUR_BROKER_SERVER          # e.g. MetaQuotes-Demo or ICMarkets-Demo01

# Common VPS MT5 terminal paths:
#   C:\Program Files\MetaTrader 5\terminal64.exe       (default install)
#   C:\Program Files (x86)\MetaTrader 5\terminal64.exe (32-bit install)
#   C:\MT5\terminal64.exe                              (custom install)
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── Trading Settings ─────────────────────────────────────────
SYMBOLS=EURUSD,XAUUSD          # comma-separated symbols to trade
TIMEFRAME=H1                   # M5, M15, H1, H4
POLL_SECONDS=60                # how often to check for signals (seconds)
BOT_MAGIC=20260202             # unique magic number for this bot's orders

# ── Telegram Notifications ────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN       # from @BotFather
TELEGRAM_CHAT_ID=YOUR_CHAT_ID          # from @userinfobot

# ── News Filter ──────────────────────────────────────────────
NEWS_FILTER_ENABLED=true
NEWS_FILTER_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
AVOID_NEWS_MINUTES=60

# ── MySQL Database (optional — JSON fallback used if absent) ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=trading_bot

# ── Advanced (optional) ───────────────────────────────────────
# TRADES_STATE_PATH=data/trades_state.json
# BOT_SWITCH_PATH=data/bot_switch.txt
# CONFIG_JSON=config/config_rsi_pullback.json

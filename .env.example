# ==============================================================================
# QUANTA-SYNTH Institutional Cloud Surveillance & Trading Environment
# ==============================================================================

# ── Container & Streamlit Server Settings ──────────────────────────────────────
PORT=8501
# Dashboard launches the trading engine on page load only when true
AUTONOMOUS_AUTOSTART=false
# Real-money MT5 accounts place orders only when true (demo accounts are unaffected)
ALLOW_LIVE_TRADING=false
PYTHONUNBUFFERED=1
PYTHONPATH=/app/src
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ── 1. Dokploy MongoDB Trade Storage ───────────────────────────────────────────
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/?authSource=admin
MONGODB_DATABASE=quanta_synth

# ── 2. Deriv MT5 Account ───────────────────────────────────────────────────────
MT5_LOGIN=YOUR_MT5_LOGIN
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Deriv-Demo

# ── 3. Synthetic Portfolio Configuration ───────────────────────────────────────
SYMBOLS=Volatility 75 Index,Volatility 75 (1s) Index,Volatility 100 Index,Volatility 100 (1s) Index,Volatility 50 Index,Volatility 25 Index,Volatility 10 Index,Crash 1000 Index,Crash 500 Index,Crash 300 Index,Boom 1000 Index,Boom 500 Index,Boom 300 Index,Step Index
TIMEFRAME=M5
POLL_SECONDS=8
BOT_MAGIC=20260909
MIN_MATH_EDGE=52.0

# ── 4. Risk Engine & Fractional Kelly ──────────────────────────────────────────
AGGRESSIVE_MODE=true
FRACTIONAL_KELLY=0.50
MAX_RISK_PER_TRADE=0.065
MAX_OPEN_TRADES=5

# ── 5. Telegram Mobile Telemetry ───────────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── 6. Deriv Cloud API & WebSocket Authentication ──────────────────────────────
DERIV_APP_ID=34MMW6sFVrG8GML5bIPRP
DERIV_API_TOKEN=your_deriv_personal_access_token

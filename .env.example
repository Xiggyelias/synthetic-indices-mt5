PORT=8501
PYTHONUNBUFFERED=1
PYTHONPATH=/app/src
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ── 1. Deriv MT5 Account ───────────────────────────────────────────────────────
MT5_LOGIN=10010627296
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Deriv-Demo

# ── 2. Synthetic Portfolio Configuration ───────────────────────────────────────
SYMBOLS=Volatility 75 Index,Volatility 75 (1s) Index,Volatility 100 Index,Volatility 100 (1s) Index,Volatility 50 Index,Volatility 25 Index,Volatility 10 Index,Crash 1000 Index,Crash 500 Index,Crash 300 Index,Boom 1000 Index,Boom 500 Index,Boom 300 Index,Step Index
TIMEFRAME=M5
POLL_SECONDS=10
BOT_MAGIC=20260909

# ── 3. Risk Engine & Fractional Kelly ──────────────────────────────────────────
AGGRESSIVE_MODE=true
FRACTIONAL_KELLY=0.45
MAX_RISK_PER_TRADE=0.05
MAX_OPEN_TRADES=4

# ── 4. Telegram Mobile Telemetry ───────────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── 5. Deriv Cloud API & WebSocket Authentication ──────────────────────────────
DERIV_APP_ID=34MMW6sFVrG8GML5bIPRP
DERIV_API_TOKEN=your_deriv_personal_access_token

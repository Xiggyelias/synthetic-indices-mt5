# ==============================================================================
# QUANTA-SYNTH & QUANTUM BRAIN - PRODUCTION HOSTING CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the root directory:
#      copy deploy\.env.production.template .env
# 2. Fill in your Deriv MT5 Account number, Password, and Server.
# 3. Test your configuration before starting:
#      python deploy\verify_deployment.py
# ==============================================================================

# ── 1. DERIV METATRADER 5 ACCOUNT (Mandatory for QUANTA-SYNTH MT5 Bot) ────────
# Your 8-digit Deriv MT5 account number (Found in Deriv.com -> CFDs -> MT5)
MT5_LOGIN=12345678

# Your Deriv MT5 account password
MT5_PASSWORD=YourDerivPasswordHere

# Server: "Deriv-Demo" (for practice) or "Deriv-Server" / "Deriv-Server-02" (for real)
MT5_SERVER=Deriv-Demo

# Path to the MT5 terminal on your Windows VPS / Host machine
# Default standard location:
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe


# ── 2. SYNTHETIC TRADING PORTFOLIO ─────────────────────────────────────────────
# Comma-separated list of active synthetic volatility indices to monitor
SYMBOLS=Volatility 75 Index,Volatility 75 (1s) Index,Volatility 100 Index,Volatility 100 (1s) Index,Volatility 50 Index,Volatility 25 Index,Volatility 10 Index,Crash 1000 Index,Crash 500 Index,Crash 300 Index,Boom 1000 Index,Boom 500 Index,Boom 300 Index,Step Index

# Base timeframe for calculating O-U mean reversion, Hurst exponent, and Garman-Klass volatility
TIMEFRAME=M5

# Loop interval in seconds (default: 10s for continuous quantitative scanning)
POLL_SECONDS=10

# Unique MetaTrader magic number used to identify this bot's orders
BOT_MAGIC=20260909


# ── 3. RISK MANAGEMENT & FRACTIONAL KELLY ENGINE ──────────────────────────────
# AGGRESSIVE_MODE: true enables half-Kelly dynamic compounding
AGGRESSIVE_MODE=true

# Fractional Kelly multiplier (0.25 to 0.50 recommended to avoid over-leverage)
FRACTIONAL_KELLY=0.35

# Maximum risk per single trade (0.01 = 1% of account equity, 0.02 = 2% max)
MAX_RISK_PER_TRADE=0.015

# Maximum simultaneous positions open across the entire portfolio
MAX_OPEN_TRADES=4


# ── 4. REAL-TIME TELEGRAM TELEMETRY (Recommended for VPS Monitoring) ─────────
# Enable instant mobile notifications for entries, partial profits, exits, and alerts
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_NUMERIC_CHAT_ID


# ── 5. DERIV WEBSOCKET API (Required ONLY for QUANTUM BRAIN v2 / Deriv Client) ─
# Deriv API token from Deriv.com -> Account Settings -> API Token (read/trade scopes)
DERIV_API_TOKEN=YOUR_DERIV_API_TOKEN
DERIV_APP_ID=1089
DERIV_API_VERSION=new


# ── 6. INSTITUTIONAL DASHBOARD HOSTING ────────────────────────────────────────
# Web UI ports for Streamlit dashboards
PORT_SYNTHETIC=8501
PORT_QUANTUM=8502

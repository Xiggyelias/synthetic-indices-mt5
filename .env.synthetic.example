# ==============================================================================
# QUANTA-SYNTH Institutional Mathematical Matrix (Deriv Synthetic Markets)
# Environment Configuration Template for Local, Docker, or VPS
# ==============================================================================

# ── Deriv MT5 Credentials ─────────────────────────────────────────────────────
# For Deriv demo accounts: Deriv-Demo
# For Deriv live accounts: Deriv-Server or Deriv-Server-02
MT5_LOGIN=YOUR_DERIV_LOGIN_NUMBER
MT5_PASSWORD=YOUR_DERIV_PASSWORD
MT5_SERVER=Deriv-Demo

# Local or VPS Windows terminal path (leave blank if running purely simulated or under Docker)
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── Synthetic Portfolio Configuration ─────────────────────────────────────────
SYMBOLS=Volatility 75 Index,Volatility 75 (1s) Index,Volatility 100 Index,Volatility 100 (1s) Index,Volatility 50 Index,Volatility 25 Index,Volatility 10 Index,Crash 1000 Index,Crash 500 Index,Crash 300 Index,Boom 1000 Index,Boom 500 Index,Boom 300 Index,Step Index
TIMEFRAME=M5
POLL_SECONDS=10
BOT_MAGIC=20260909

# ── Super-Elite Risk & Compounding Engine ──────────────────────────────────────
AGGRESSIVE_MODE=true
FRACTIONAL_KELLY=0.45
MAX_RISK_PER_TRADE=0.05
MAX_OPEN_TRADES=6

# ── Real-Time Telegram Telemetry ──────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

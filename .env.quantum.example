# ==============================================================================
# Quantum Brain v2 — environment template (copy the lines you need into .env)
# .env is git-ignored. Never commit a real token.
# ==============================================================================

# ── Safety defaults (do not change unless you mean to) ────────────────────────
# Allowed: paper | demo. Anything else (e.g. live) is refused at startup.
TRADING_MODE=paper
# Must stay true. There is no real-money mode in this codebase.
DEMO_ONLY=true
# Only the isolated demo workflow (`quantum_brain.py demo`) reads this, and only with TRADING_MODE=demo.
ENABLE_TRADING=false

# ── Deriv API ─────────────────────────────────────────────────────────────────
# Register an app id at https://developers.deriv.com (Manage Applications).
DERIV_APP_ID=
# Needed only for the demo workflow. Create it on a DEMO account with the scopes "read" and "trade".
DERIV_API_TOKEN=
# New API only: the DEMO account id whose one-time WebSocket URL the demo workflow requests.
DERIV_ACCOUNT_ID=
# new (default): market data from the public endpoint below, no login needed.
# legacy: wss://ws.derivws.com/websockets/v3 (+ app_id) — answered HTTP 520 when checked on 2026-10-24.
DERIV_API_VERSION=new
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# ── Research ──────────────────────────────────────────────────────────────────
QB2_SYMBOLS=R_10,R_25,R_50,R_75,R_100,1HZ10V,1HZ25V,1HZ50V,1HZ75V,1HZ100V
QB2_DB_PATH=data/quantum_brain.db
QB2_MODEL_DIR=data/qb2_models
QB2_DECISION_INTERVAL=60
QB2_LATENCY_SECONDS=1.0
QB2_MIN_EDGE_FRACTION=0.02
QB2_UNCERTAINTY_Z=1.0

# ── Risk limits (optional overrides; see src/qb2/config.py RiskLimits) ────────
# QB2_RISK_MAX_STAKE_FRACTION=0.01
# QB2_RISK_MAX_DAILY_LOSS_FRACTION=0.03
# QB2_RISK_MAX_DRAWDOWN_FRACTION=0.10
# QB2_RISK_MAX_TRADES_PER_DAY=20
# QB2_RISK_CONSECUTIVE_LOSS_LIMIT=4
